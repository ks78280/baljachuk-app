# 이 파일을 .env 로 복사해서 사용. Expo는 EXPO_PUBLIC_* 변수만 클라이언트에 노출한다.
# .env 를 바꾸면 Metro 를 재시작해야 반영된다.

# false = 실 백엔드(baljachuk-api) 호출, true = src/mocks/db.ts 목 데이터
EXPO_PUBLIC_USE_MOCK=false
# NestJS API 베이스. 실기기(Expo Go)에서는 localhost 대신 PC 의 LAN IP 사용.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api
