# .env 로 복사. Expo는 EXPO_PUBLIC_* 변수만 클라이언트 번들에 노출한다.
# .env 를 바꾸면 Metro 재시작 필요.

# false = 실 백엔드 호출, true = src/mocks/db.ts 목 데이터
EXPO_PUBLIC_USE_MOCK=false

# 로컬:   http://localhost:4000/api
# 실기기: http://<PC의 LAN IP>:4000/api
# 배포:   https://<railway-앱>.up.railway.app/api   (Vercel 환경변수에 설정)
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api
