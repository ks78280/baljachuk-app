{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_USE_MOCK": "false",
        "EXPO_PUBLIC_API_BASE_URL": "https://baljachuk-api-production.up.railway.app/api"
      },
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_USE_MOCK": "false",
        "EXPO_PUBLIC_API_BASE_URL": "https://baljachuk-api-production.up.railway.app/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}